#include <windows.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VERSION_RC_NUM
PRODUCTVERSION  VERSION_RC_NUM
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DolphinWing"
            VALUE "FileDescription",  "MouseMover - Screen Idle Prevention Utility"
            VALUE "FileVersion",      VERSION_STRING
            VALUE "InternalName",     "MouseMover.exe"
            VALUE "LegalCopyright",   "Copyright (c) DolphinWing"
            VALUE "OriginalFilename", "MouseMover.exe"
            VALUE "ProductName",      "MouseMover"
            VALUE "ProductVersion",   VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
